        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 0.2 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
      <pose>0 -12 1.25 0 0 0</pose>
    </model>

    <!-- West wall -->
    <model name="outer_wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 24 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 24 2.5</size>
            </box>
