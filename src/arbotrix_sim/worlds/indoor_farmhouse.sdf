    <!-- ========================= -->
    <!-- ROOM B - LEFT -->
    <!-- ========================= -->

    <!-- Back wall -->
    <model name="room_b_back">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.2 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.2 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>

      <pose>-8.5 7 1.25 0 0 0</pose>
    </model>

