    </model>


    <!-- ========================= -->
    <!-- HOME / SPAWN BAY -->
    <!-- ========================= -->

    <!-- Home back wall -->
    <model name="home_back_wall">
      <static>true</static>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>3 0.2 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>3 0.2 2.5</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>0 11.5 1.25 0 0 0</pose>
    </model>

    <!-- Home left wall -->
    <model name="home_left_wall">
      <static>true</static>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 3 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 3 2.5</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>-1.5 10 1.25 0 0 0</pose>
    </model>

    <!-- Home right wall -->
    <model name="home_right_wall">
      <static>true</static>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 3 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 3 2.5</size>
            </box>
          </geometry>
        </visual>

      </link>

      <pose>1.5 10 1.25 0 0 0</pose>
    </model>


    <!-- ========================= -->
    <!-- ROOM A SENSOR STATION -->
    <!-- ========================= -->

    <!--
      Fixed environmental sensor for Room A.
      This is visual only and has NO collision.
      Later the ROS 2 inspection system will provide:
        /room_a/temperature
        /room_a/humidity
    -->

    <model name="room_a_sensor">
      <static>true</static>

      <link name="link">

        <visual name="sensor_body">
          <geometry>
            <box>
              <size>0.45 0.15 0.55</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.7 0.8 1</ambient>
            <diffuse>0.1 0.7 0.8 1</diffuse>
          </material>
        </visual>

        <visual name="sensor_indicator">
          <pose>0 0.081 0.08 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.06</radius>
            </sphere>
          </geometry>

          <material>
            <ambient>0.1 1 0.1 1</ambient>
            <diffuse>0.1 1 0.1 1</diffuse>
            <emissive>0.1 0.5 0.1 1</emissive>
          </material>
        </visual>

      </link>

      <pose>8.5 6.82 1.25 0 0 0</pose>

      <plugin name="room_a_environmental_sensor" filename="libenvironmental_sensor_plugin.so">
        <temperature>24.0</temperature>
        <humidity>35.0</humidity>
      </plugin>
    </model>


    <!-- ========================= -->
    <!-- ROOM B SENSOR STATION -->
    <!-- ========================= -->

    <!--
      Fixed environmental sensor for Room B.
      This is visual only and has NO collision.
      Later the ROS 2 inspection system will provide:
        /room_b/temperature
        /room_b/humidity
    -->

    <model name="room_b_sensor">
      <static>true</static>

      <link name="link">

        <visual name="sensor_body">
          <geometry>
            <box>
              <size>0.45 0.15 0.55</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.7 0.8 1</ambient>
            <diffuse>0.1 0.7 0.8 1</diffuse>
          </material>
        </visual>

        <visual name="sensor_indicator">
          <pose>0 0.081 0.08 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.06</radius>
            </sphere>
          </geometry>

          <material>
            <ambient>0.1 1 0.1 1</ambient>
            <diffuse>0.1 1 0.1 1</diffuse>
            <emissive>0.1 0.5 0.1 1</emissive>
          </material>
        </visual>

      </link>

      <pose>-8.5 6.82 1.25 0 0 0</pose>

      <plugin name="room_b_environmental_sensor" filename="libenvironmental_sensor_plugin.so">
        <temperature>15.0</temperature>
        <humidity>50.0</humidity>
      </plugin>
    </model>


    <!-- ========================= -->
    <!-- OBSTACLE 1 -->
    <!-- ========================= -->

    <model name="obstacle_1">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 1.5 1.0</size>
            </box>
          </geometry>
        </collision>

