<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="indoor_farmhouse">

    <!-- ========================= -->
    <!-- LIGHTING -->
    <!-- ========================= -->

    <include>
      <uri>model://sun</uri>
    </include>


    <!-- ========================= -->
    <!-- GROUND -->
    <!-- ========================= -->

    <model name="floor">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>30 24 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30 24 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!-- OUTER WALLS -->
    <!-- ========================= -->

    <!-- North wall -->
    <model name="outer_wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 0.2 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
      <pose>0 12 1.25 0 0 0</pose>
    </model>

    <!-- South wall -->
    <model name="outer_wall_south">
