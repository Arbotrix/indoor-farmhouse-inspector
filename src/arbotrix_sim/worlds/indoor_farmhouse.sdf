          </geometry>

          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>

        </visual>

      </link>

      <pose>-7 -0.5 0.5 0 0 0</pose>
    </model>


    <!-- ========================= -->
